# ─── 데이터베이스 ───────────────────────────────────────────
# PostgreSQL 접속 문자열 (배포 시 호스팅 DB의 연결 문자열로 교체)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/maumjari?schema=public"

# ─── 인증 ──────────────────────────────────────────────────
# 로그인 세션 서명용 비밀키. 최소 32자 이상의 무작위 문자열.
# 생성 예: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ─── 서비스 URL ────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─── 결제 (PG 어댑터) ──────────────────────────────────────
# mock  : 개발/테스트용 가짜 결제 (실제 돈이 오가지 않음)
# 실제 PG사 계약 후 어댑터를 추가하고 이 값을 바꾼다 (src/lib/payments 참고)
PAYMENT_PROVIDER="mock"
PG_CLIENT_KEY=""
PG_SECRET_KEY=""
PG_WEBHOOK_SECRET=""

# ─── 소셜 로그인 (키가 있는 제공자만 로그인 화면에 버튼이 보임) ─────
# 구글: https://console.cloud.google.com → OAuth 클라이언트 ID(웹) → 승인된 리디렉션 URI 에
#       https://<서비스주소>/api/auth/oauth/google/callback 등록
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 네이버: https://developers.naver.com → 애플리케이션 등록(네이버 로그인, 제공 항목: 이메일·이름) → Callback URL 에
#       https://<서비스주소>/api/auth/oauth/naver/callback 등록
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# 콜백 주소의 기준 도메인. 비우면 접속한 주소를 그대로 사용 (미리보기 주소가 매번 바뀌는 Vercel 에서는 비워두는 편이 편함)
OAUTH_REDIRECT_BASE=""

# ─── 정책 값 ───────────────────────────────────────────────
# 플랫폼 수수료율 (0.15 = 15%)
PLATFORM_FEE_RATE="0.15"
# 지도자가 예약 요청에 응답해야 하는 시간 (시간 단위)
BOOKING_RESPONSE_HOURS="24"

# ─── 알림 (이메일) ─────────────────────────────────────────
# console : 이메일을 실제로 보내지 않고 서버 로그에만 출력
# 실제 발송 서비스 계약 후 src/lib/notify.ts 의 어댑터를 추가
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@example.com"

# ─── 예약 작업(Cron) 보호용 비밀키 ─────────────────────────
CRON_SECRET="change-me-cron-secret"

# ─── 최초 관리자 계정 (seed 실행 시 생성) ──────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"
